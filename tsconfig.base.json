{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@flighthq/flight": ["packages/flight/src/index.ts"],
      "@flighthq/flight/*": ["packages/flight/src/*"]
    },
    "types": ["@testing-library/jest-dom", "vitest/globals"] // Include Vitest globals for type-checking
  },
  "include": ["packages/*/src"],
  "exclude": ["node_modules", "dist"]
}
